<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_3_Part_1.PlainBagelPage"
             Title="Plain Bagel">

    <ContentPage.Resources>
        <Color x:Key="Brand">#FF9F80</Color>
        <Color x:Key="Price">#B3261E</Color>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="24" Spacing="15">

        <Image Source="plain_bagel.jpeg"
               HeightRequest="250" />

        <Label Text="Plain Bagel"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Brand}" />

        <Label Text="$2.25"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource Price}" />

        <Label Text="A simple plain bagel."
               FontSize="17" />

        <Label Text="In stock"
               FontSize="17"
               TextColor="Green" />

        <Label Text="Quantity"
               FontSize="17" />

        <Entry x:Name="QuantityEntry"
               Text="1"
               Keyboard="Numeric" />

        <Button Text="Add to cart"
                BackgroundColor="{StaticResource Brand}"
                TextColor="Black"
                Clicked="AddToCartClicked" />

        <Label x:Name="messageLabel"
               FontSize="17" />

    </VerticalStackLayout>

</ContentPage>