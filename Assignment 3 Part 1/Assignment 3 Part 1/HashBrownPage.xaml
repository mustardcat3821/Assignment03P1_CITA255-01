<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_3_Part_1.HashBrownPage"
             Title="Hash Brown">

    <ContentPage.Resources>
        <Color x:Key="Brand">#FF9F80</Color>
        <Color x:Key="Price">#B3261E</Color>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="24" Spacing="15">

        <Image Source="hash_brown.jpg"
               HeightRequest="250" />

        <Label Text="Hash Brown"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Brand}" />

        <Label Text="$1.95"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource Price}" />

        <Label Text="A crispy golden hash brown."
               FontSize="17" />

        <Label Text="Out of stock"
               FontSize="17"
               TextColor="Red" />

        <Label Text="Quantity"
               FontSize="17" />

        <Entry Text="1"
               IsEnabled="False" />

        <Button Text="Add to cart"
                BackgroundColor="Gray"
                TextColor="White"
                IsEnabled="False" />

        <Label Text="This item is currently unavailable."
               FontSize="17"
               TextColor="Gray" />

    </VerticalStackLayout>

</ContentPage>