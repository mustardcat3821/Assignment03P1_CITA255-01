<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_3_Part_1.CheckoutPage"
             Title="Checkout">

    <Grid Padding="24"
          RowDefinitions="Auto,*,Auto,Auto,Auto"
          RowSpacing="20">

        <Label Grid.Row="0"
               Text="Your Basket"
               Style="{StaticResource PageTitleStyle}" />

        <CollectionView x:Name="CartItems"
                        Grid.Row="1">

            <CollectionView.EmptyView>
                <Label Text="Nothing in your cart yet."
                       TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}"
                           Padding="0,8"
                           Style="{StaticResource BodyTextStyle}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Label x:Name="TotalLabel"
               Grid.Row="2"
               Text="Total: $0.00"
               Style="{StaticResource PriceTextStyle}" />

        <Button Grid.Row="3"
                Text="Checkout"
                Style="{StaticResource StoreButtonStyle}"
                Clicked="CheckoutClicked" />

        <Label x:Name="OrderMessageLabel"
               Grid.Row="4"
               Style="{StaticResource BodyTextStyle}" />

    </Grid>

</ContentPage>